<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ override of the plain alias in values/themes.xml. Resource
         qualifiers (not a compat library) are what make this safe: a device
         below API 31 never loads this file at all, so referencing framework
         android:windowSplashScreen* attributes/android:Theme.SplashScreen here
         — which don't exist pre-31 — never gets resolved on a device that
         wouldn't understand them. -->
    <style name="Theme.App.Starting" parent="@android:style/Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/generated_image</item>
        <item name="android:windowSplashScreenAnimationDuration">500</item>
        <item name="android:postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
