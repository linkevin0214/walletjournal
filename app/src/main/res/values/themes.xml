<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Launch (cold-start) theme, set on the launcher activity only (AccountsActivity)
         via the AndroidX SplashScreen compat library — draws natively on Android 12+
         and is emulated on older versions back to the app's minSdk. postSplashScreenTheme
         is what the activity's theme becomes once the splash is dismissed. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/generated_image</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>

    <!-- Base application theme. -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Used by the "選擇分類" BottomSheetDialog (AddRecordActivity). The default
         bottomSheetStyle paints its own square background behind our content, which
         peeks out around dialog_category_picker.xml's rounded top corners; making it
         transparent here lets only our bg_bottom_sheet_top_rounded shape show. -->
    <style name="AppBottomSheetDialogTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalBottomSheet</item>
    </style>

    <style name="AppModalBottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <!-- The default style also gives this container elevation, which makes
             Android cast a rectangular drop shadow from its (still rectangular)
             outline — that square shadow sits right behind our rounded content
             and reads as "the corners aren't actually rounded". Drop it; the
             dialog's dim scrim already separates the sheet from the page. -->
        <item name="android:elevation">0dp</item>
    </style>
</resources>